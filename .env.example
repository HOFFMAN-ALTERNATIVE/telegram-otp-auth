# 32+ random bytes; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
REDIS_URL=redis://redis:6379/0

# From @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN
BOT_USERNAME=your_login_bot

CODE_LENGTH=6
CHALLENGE_TTL_SECONDS=300
CODE_TTL_SECONDS=120
MAX_VERIFY_ATTEMPTS=5
MAX_CODES_PER_CHALLENGE=3
LOCKOUT_THRESHOLD=10
LOCKOUT_WINDOW_SECONDS=3600
LOCKOUT_SECONDS=900
START_PER_IP_PER_MINUTE=10
VERIFY_PER_IP_PER_MINUTE=20
CODES_PER_USER_PER_HOUR=10
SESSION_TTL_SECONDS=604800

# Local http demo: false. Behind HTTPS: true.
COOKIE_SECURE=false
# Set to 1 when running behind exactly one reverse proxy that sets X-Forwarded-For
TRUSTED_PROXY_COUNT=0
